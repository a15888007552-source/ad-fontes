# Copy this file to .env for a local run. Never commit .env or a token.
PORT=8787
HOST=127.0.0.1
ALLOW_ORIGIN=http://localhost:4173,http://127.0.0.1:4173,https://gusgumee.studio,https://www.gusgumee.studio
SITE_BASE_URL=https://gusgumee.studio/

# Optional locally. If omitted, the SDK can use the signed-in Copilot CLI/GitHub session.
# COPILOT_GITHUB_TOKEN=gho_replace_me

# Copilot Student currently exposes model selection through auto routing.
COPILOT_MODEL=auto
