{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://a15888007552-source.github.io/ad-fontes/schemas/module.schema.json",
  "title": "Ad Fontes module metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "type",
    "status",
    "version",
    "entry",
    "maintainer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived",
        "experimental"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\]+$"
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "dataVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
